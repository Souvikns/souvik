---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { DATA } from "@/data/resume";
import Hero from "@/components/home/Hero.astro";
import Highlights from "@/components/home/Highlights.astro";
import ProjectsSection from "@/components/home/ProjectsSection.astro";
import ContactSection from "@/components/home/ContactSection.astro";
import { getContributionCalendar } from "@/lib/github";

const posts = (await getCollection("blog", ({ data }) => data.published))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
  .slice(0, 3);
const contributions = await getContributionCalendar(DATA.github.username);

const sectionComponents = {
  highlights: () => ({ Component: Highlights, props: { posts, contributions } }),
  projects: () => ({ Component: ProjectsSection, props: {} }),
  contact: () => ({ Component: ContactSection, props: {} }),
} as const;

const orderedSections = Object.entries(DATA.sections)
  .filter(([, s]) => s.enabled)
  .sort(([, a], [, b]) => a.order - b.order)
  .map(([key]) => sectionComponents[key as keyof typeof sectionComponents]());

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${DATA.url}/#person`,
      name: DATA.name,
      jobTitle: DATA.jobTitle,
      description: DATA.summary.replace(/\s+/g, " ").trim(),
      url: DATA.url,
      image: `${DATA.url}${DATA.avatarUrl}`,
      email: `mailto:${DATA.contact.email}`,
      address: {
        "@type": "PostalAddress",
        addressLocality: DATA.location,
      },
      knowsAbout: DATA.skills.map((skill) => skill.name),
      sameAs: Object.values(DATA.contact.social)
        .map((social) => social.url)
        .filter((url) => !url.startsWith("mailto:")),
      worksFor: {
        "@type": "Organization",
        name: DATA.work[0].company,
        url: DATA.work[0].href,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${DATA.url}/#website`,
      url: DATA.url,
      name: `${DATA.name} - ${DATA.jobTitle}`,
      description: DATA.description,
      inLanguage: "en",
      publisher: { "@id": `${DATA.url}/#person` },
    },
  ],
}).replace(/</g, "\\u003c");
---

<Layout>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <Hero />
  {orderedSections.map(({ Component, props }) => <Component {...(props as any)} />)}
</Layout>
