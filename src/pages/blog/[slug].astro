---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { DATA } from "@/data/resume";
import { mdxComponents } from "@/mdx-components";
import { ArrowLeft } from "lucide-react";
import { orderPostsByPart, getAdjacentParts } from "@/lib/series";
import { longDate } from "@/lib/dates";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const seriesEntries = await getCollection("series");
  const seriesBySlug = new Map(seriesEntries.map((s) => [s.id, s]));
  const sortedPosts = [...posts].sort((a, b) => {
    if (new Date(a.data.publishedAt) > new Date(b.data.publishedAt)) return -1;
    return 1;
  });
  const isDev = import.meta.env.DEV;
  const publishedPosts = sortedPosts.filter(
    (post) => isDev || post.data.published,
  );

  return publishedPosts.map((post) => {
    const index = publishedPosts.findIndex((p) => p.id === post.id);

    let postSeries: CollectionEntry<"series"> | null = null;
    let seriesParts: CollectionEntry<"blog">[] = [];
    let seriesPrev: CollectionEntry<"blog"> | null = null;
    let seriesNext: CollectionEntry<"blog"> | null = null;
    if (post.data.series) {
      const seriesEntry = seriesBySlug.get(post.data.series);
      if (seriesEntry) {
        postSeries = seriesEntry;
        seriesParts = orderPostsByPart(
          publishedPosts.filter(
            (p) =>
              p.data.series === post.data.series &&
              p.data.seriesPart !== undefined,
          ),
        );
        const { previous, next } = getAdjacentParts(seriesParts, post.id);
        seriesPrev = previous;
        seriesNext = next;
      } else {
        console.warn(
          `[series] blog post "${post.id}" references unknown series "${post.data.series}"`,
        );
      }
    }

    return {
      params: { slug: post.id },
      props: {
        post,
        previousPost: index > 0 ? publishedPosts[index - 1] : null,
        nextPost:
          index >= 0 && index < publishedPosts.length - 1
            ? publishedPosts[index + 1]
            : null,
        postSeries,
        seriesParts,
        seriesPrev,
        seriesNext,
      },
    };
  });
}

const {
  post,
  previousPost,
  nextPost,
  postSeries,
  seriesParts,
  seriesPrev,
  seriesNext,
} = Astro.props;
const { title, publishedAt, updatedAt, summary, image, published, tags, devto, seriesPart } =
  post.data;
const slug = post.id;
const postUrl = `${DATA.url}/blog/${slug}`;
const postImage = image
  ? image.startsWith("http")
    ? image
    : `${DATA.url}${image}`
  : `${DATA.url}${DATA.ogImage}`;

const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const prevLink = postSeries ? seriesPrev : nextPost;
const nextLink = postSeries ? seriesNext : previousPost;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: publishedAt,
  dateModified: updatedAt ?? publishedAt,
  description: summary,
  image: postImage,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  keywords: tags,
  author: {
    "@type": "Person",
    "@id": `${DATA.url}/#person`,
    name: DATA.name,
    url: DATA.url,
  },
  publisher: { "@id": `${DATA.url}/#person` },
}).replace(/</g, "\\u003c");
---

<Layout
  title={title}
  description={summary}
  image={image}
  imageAlt={title}
  canonicalURL={postUrl}
  type="article"
  publishedTime={new Date(publishedAt).toISOString()}
  modifiedTime={new Date(updatedAt ?? publishedAt).toISOString()}
  tags={tags}
  noindex={!published}
>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
  <section class="pt-14">
    <a href="/blog" class="inline-flex items-center gap-1.5 text-base font-medium text-muted-foreground hover:text-foreground transition-colors">
      <ArrowLeft className="size-4" aria-hidden /> All posts
    </a>
    {
      (postSeries || !published) && (
        <div class="mt-7 flex flex-wrap gap-2">
          {postSeries && (
            <a href={`/series/${postSeries.id}`} class="rounded-full bg-brand-soft px-3.5 py-1.5 text-sm font-medium text-brand-foreground hover:underline">
              {postSeries.data.title} · Part {seriesPart} of {seriesParts.length}
            </a>
          )}
          {!published && <span class="rounded-full bg-muted px-3.5 py-1.5 text-sm font-medium text-muted-foreground">Draft</span>}
        </div>
      )
    }
    <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-[1.06] tracking-tighter sm:text-6xl">{title}</h1>
    <div class="mt-7 flex items-center gap-3.5 text-base text-muted-foreground">
      <img src={DATA.avatarThumbUrl} alt="" width="44" height="44" class="size-11 rounded-xl object-cover" />
      <span>
        <span class="block font-medium text-foreground">{post.data.author ?? DATA.name}</span>
        <span class="block font-mono text-sm">
          <time datetime={publishedAt}>{longDate(publishedAt)}</time>{devto && " · Also on dev.to"}
        </span>
      </span>
    </div>
  </section>

  <div class="mt-12 flex flex-wrap items-start gap-12">
    <article
      class="prose prose-lg min-w-0 max-w-3xl flex-[999_1_34rem] rounded-4xl border border-border bg-card p-6 text-pretty font-sans leading-relaxed text-foreground/85 dark:prose-invert sm:p-12 prose-headings:text-foreground prose-headings:scroll-mt-8"
    >
      <Content components={mdxComponents} />
      {
        tags.length > 0 && (
          <div class="not-prose mt-10 flex flex-wrap gap-2 border-t border-border pt-6">
            {tags.map((tag) => (
              <span class="rounded-full bg-muted px-3 py-1.5 font-mono text-sm text-foreground/80">#{tag}</span>
            ))}
          </div>
        )
      }
    </article>

    <aside class="flex min-w-0 flex-[1_1_16rem] flex-col gap-4 lg:sticky lg:top-8">
      {
        toc.length > 0 && (
          <nav aria-label="On this page" class="rounded-3xl border border-border bg-card p-5.5">
            <span class="inline-block rounded-full bg-muted px-3.5 py-1.5 text-sm font-medium">On this page</span>
            <ul class="mt-4 flex flex-col gap-1 text-base">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="block border-l-2 border-border py-2 pl-3.5 text-muted-foreground transition-colors hover:border-brand hover:text-foreground">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      {
        postSeries && (
          <nav aria-label="Series" class="rounded-3xl bg-primary p-5.5 text-primary-foreground">
            <a href={`/series/${postSeries.id}`} class="inline-flex items-center gap-2 rounded-full bg-primary-foreground/10 px-3.5 py-1.5 text-sm font-medium hover:bg-primary-foreground/15">
              <span class="size-2 rounded-full bg-brand" aria-hidden="true" />
              {postSeries.data.title}
            </a>
            <ol class="mt-4 flex flex-col gap-2 text-base">
              {seriesParts.map((part, i) => (
                <li>
                  {part.id === post.id ? (
                    <span aria-current="page" class="block rounded-2xl bg-primary-foreground/10 px-3.5 py-3">
                      <span class="font-mono text-primary-foreground/65">{String(i + 1).padStart(2, "0")}</span> · You're reading this
                    </span>
                  ) : (
                    <a href={`/blog/${part.id}`} class="block rounded-2xl border border-primary-foreground/15 px-3.5 py-3 transition-colors hover:bg-primary-foreground/8">
                      <span class="font-mono text-primary-foreground/65">{String(i + 1).padStart(2, "0")}</span> · {part.data.title}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>
  </div>

  <nav aria-label="More posts" class="mt-12 grid max-w-3xl gap-3 sm:grid-cols-2">
    {
      prevLink ? (
        <a href={`/blog/${prevLink.id}`} class="rounded-3xl border border-border bg-card p-5 transition-colors hover:bg-muted">
          <span class="text-sm text-muted-foreground">← {postSeries ? "Previous in series" : "Older"}</span>
          <span class="mt-1.5 block text-lg font-medium leading-snug">{prevLink.data.title}</span>
        </a>
      ) : <span class="hidden sm:block" />
    }
    {
      nextLink && (
        <a href={`/blog/${nextLink.id}`} class="rounded-3xl border border-border bg-card p-5 text-right transition-colors hover:bg-muted">
          <span class="text-sm text-muted-foreground">{postSeries ? "Next in series" : "Newer"} →</span>
          <span class="mt-1.5 block text-lg font-medium leading-snug">{nextLink.data.title}</span>
        </a>
      )
    }
  </nav>

  <section class="mt-4 flex max-w-3xl flex-wrap items-center gap-5 rounded-3xl border border-border bg-card p-6">
    <img src={DATA.avatarThumbUrl} alt="" width="64" height="64" class="size-16 rounded-2xl object-cover" />
    <div class="flex-[1_1_16rem]">
      <p class="text-lg font-semibold">Written by {DATA.name}</p>
      <p class="mt-0.5 text-base text-muted-foreground">{DATA.hero.role} at {DATA.hero.company}. Building in public.</p>
    </div>
    <a href={`mailto:${DATA.contact.email}`} class="rounded-full bg-primary px-6 py-3.5 text-base font-medium text-primary-foreground transition-opacity hover:opacity-90">
      {DATA.hero.cta}
    </a>
  </section>
</Layout>
