---
import type { CollectionEntry } from "astro:content";
import { DATA } from "@/data/resume";
import ExperienceCard, { type ExperienceRole } from "@/components/home/ExperienceCard";
import { shortDate, shortMonthYear, yearRange } from "@/lib/dates";
import type { ContributionCalendar } from "@/lib/github";
import { ArrowUpRight, MapPin } from "lucide-react";
import { Icons } from "@/components/icons";

interface Props {
  posts: CollectionEntry<"blog">[];
  contributions: ContributionCalendar | null;
}

const { posts, contributions } = Astro.props;
const { labels, experienceMore } = DATA.sections.highlights;

const roles: ExperienceRole[] = DATA.work.map((w) => ({
  company: w.company,
  href: w.href,
  title: w.title,
  location: w.location,
  type: w.badges[0] ?? "",
  range: `${shortMonthYear(w.start)} — ${w.end ? shortMonthYear(w.end) : "Present"}`,
  span: yearRange(w.start, w.end),
  current: !w.end,
  points: w.description.map((p) => p.replace(/\s+/g, " ").trim()),
}));
const firstYear = DATA.work.at(-1)?.start.match(/\d{4}/)?.[0];
const experienceSummary = `${roles.length} roles · ${firstYear} — present`;

const building = DATA.projects.find((p) => p.featured) ?? DATA.projects[0];

const levelClass = ["bg-muted", "bg-brand/25", "bg-brand/50", "bg-brand/75", "bg-brand"];
const weeks = contributions?.weeks ?? [];
const githubUrl = `https://github.com/${DATA.github.username}`;
---

<section id="work" aria-label="Highlights" class="relative grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  <ExperienceCard
    client:load
    label={labels.experience}
    moreLabel={experienceMore}
    summary={experienceSummary}
    roles={roles}
  />

  <article class="flex flex-col rounded-3xl border border-border bg-card p-6">
    <span class="self-start rounded-full bg-muted px-3.5 py-1.5 text-sm font-medium">{labels.building}</span>
    <a href={`/projects/${building.slug}`} class="mt-5 block overflow-hidden rounded-2xl border border-border">
      <img
        src={building.image}
        alt={`${building.title} screenshot`}
        loading="lazy"
        width="1200"
        height="750"
        class="aspect-[16/10] w-full object-cover transition-transform duration-300 hover:scale-[1.02] motion-reduce:transition-none"
      />
    </a>
    <div class="mt-4 flex items-end justify-between gap-3">
      <div>
        <a href={`/projects/${building.slug}`} class="text-xl font-semibold tracking-tight hover:text-brand-foreground transition-colors">
          {building.title}
        </a>
        <p class="mt-0.5 text-sm text-muted-foreground">{building.tagline}</p>
      </div>
      <a
        href={building.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-1 text-sm font-medium text-brand-foreground hover:underline"
      >
        {new URL(building.href).hostname.replace(/^www\./, "")}
        <ArrowUpRight className="size-3.5" aria-hidden />
      </a>
    </div>
  </article>

  <article class="rounded-3xl border border-border bg-card p-6">
    <span class="inline-block rounded-full bg-muted px-3.5 py-1.5 text-sm font-medium">{labels.openSource}</span>
    <ul class="mt-5 flex flex-col gap-3">
      {
        DATA.openSource.map((item, i) => (
          <li class="flex items-center gap-3.5 rounded-2xl bg-muted p-3.5">
            <span
              class:list={[
                "flex size-11 shrink-0 items-center justify-center rounded-xl text-sm font-semibold",
                i === 0 && "bg-primary text-primary-foreground",
                i === 1 && "bg-brand-soft text-brand-foreground",
                i > 1 && "border border-border bg-card",
              ]}
              aria-hidden="true"
            >
              {item.mark}
            </span>
            <span>
              <span class="block font-medium">{item.name}</span>
              <span class="block text-sm text-muted-foreground">{item.detail}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </article>

  {
    contributions && (
      <article class="rounded-3xl border border-border bg-card p-6 md:col-span-2">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span class="rounded-full bg-muted px-3.5 py-1.5 text-sm font-medium">{labels.github}</span>
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-foreground/80 hover:text-foreground"
          >
            <Icons.github className="size-4" aria-hidden />@{DATA.github.username}
          </a>
        </div>
        <div
          role="img"
          aria-label={`GitHub contribution graph${contributions.total ? `: ${contributions.total} contributions in the last year` : ""}`}
          class="mt-5 flex gap-1"
        >
          {weeks.map((week, wi) => (
            <div class:list={["flex min-w-0 flex-1 flex-col gap-1", wi < weeks.length - 26 && "max-sm:hidden"]}>
              {week.map((day) => (
                <span class:list={["block aspect-square rounded-xs", levelClass[day.level]]} />
              ))}
            </div>
          ))}
        </div>
        <div class="mt-3.5 flex flex-wrap items-center justify-between gap-3 text-sm text-muted-foreground">
          <span>{contributions.total !== null ? `${contributions.total.toLocaleString("en-US")} contributions in the last year` : "Contributions in the last year"}</span>
          <span class="inline-flex items-center gap-1" aria-hidden="true">
            Less
            {levelClass.map((c) => <span class:list={["size-2.5 rounded-xs", c]} />)}
            More
          </span>
        </div>
      </article>
    )
  }

  <article class="relative min-h-64 overflow-hidden rounded-3xl border border-border bg-card p-6">
    <div class="map-grid absolute inset-0" aria-hidden="true"></div>
    <div class="absolute -inset-x-[10%] top-[58%] h-2.5 -rotate-12 bg-border" aria-hidden="true"></div>
    <div class="absolute -inset-y-[10%] left-[62%] w-2 rotate-[18deg] bg-border" aria-hidden="true"></div>
    <span class="relative inline-block rounded-full border border-border bg-card px-3.5 py-1.5 text-sm font-medium">{labels.location}</span>
    <div class="absolute top-[56%] left-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-2.5">
      <span class="size-5 rounded-full border-4 border-card bg-brand ring-8 ring-brand/20" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-border bg-card px-3.5 py-2 text-sm font-medium">
        <MapPin className="size-3.5" aria-hidden />
        {DATA.location} · {DATA.timezone}
      </span>
    </div>
  </article>

  <article class="rounded-3xl border border-border bg-card p-6 md:col-span-2">
    <div class="flex items-center justify-between gap-3">
      <span class="rounded-full bg-muted px-3.5 py-1.5 text-sm font-medium">{labels.writing}</span>
      <a href="/blog" class="text-sm font-medium text-foreground/80 hover:text-foreground">All posts →</a>
    </div>
    <ul class="mt-3">
      {
        posts.map((post) => (
          <li class="border-b border-border last:border-b-0">
            <a href={`/blog/${post.id}`} class="group flex items-center justify-between gap-4 py-4">
              <span class="text-base font-medium sm:text-lg group-hover:text-brand-foreground transition-colors">
                {post.data.title}
                {post.data.seriesPart && (
                  <span class="ml-1.5 whitespace-nowrap rounded-full bg-brand-soft px-2.5 py-0.5 align-middle text-xs font-medium text-brand-foreground">
                    Series · {post.data.seriesPart}
                  </span>
                )}
              </span>
              <span class="shrink-0 font-mono text-sm text-muted-foreground">{shortDate(post.data.publishedAt)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </article>

  <article class="rounded-3xl bg-primary p-6 text-primary-foreground">
    <span class="inline-block rounded-full bg-primary-foreground/10 px-3.5 py-1.5 text-sm font-medium">{labels.stack}</span>
    <ul class="mt-5 flex flex-wrap gap-2">
      {
        DATA.skills.map((skill) => (
          <li class="rounded-full border border-primary-foreground/20 px-3.5 py-1.5 text-base">{skill.name}</li>
        ))
      }
    </ul>
  </article>
</section>
